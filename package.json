{
  "name": "@andybarilla/flock",
  "version": "0.1.0",
  "description": "Pi-native skills, prompt templates, agents, and extensions for managing software development sessions.",
  "private": true,
  "keywords": [
    "pi-package",
    "pi",
    "skills",
    "prompt-templates",
    "coding-agent"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      ".pi/extensions"
    ],
